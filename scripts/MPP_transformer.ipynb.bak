{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Attention-Based Earthquake Catalog Continuation\n",
        "\n",
        "This notebook implements a Marked Temporal Point Process (MTPP) Transformer. It directly models continuous inter-event times (`dt`) and magnitudes (`m`) without discrete text tokenization, and handles unobserved event combinations via a Mixture Density Network (MDN) output head."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "import math"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Stage 1: Input Data Not String\n",
        "Instead of transforming the data to strings like `'t100m3.2'` and using a standard tokenizer, we feed the network a sequence of continuous vectors. We extract inter-event times (`dt`) and `magnitude`, then normalize them."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Stage 1: Input data not string.\n",
        "# We maintain the metric topology by feeding continuous sequences of (dt, m).\n",
        "\n",
        "class EarthquakeDataset(Dataset):\n",
        "    def __init__(self, csv_file, seq_length=100):\n",
        "        # Load catalog\n",
        "        df = pd.read_csv(csv_file)\n",
        "        \n",
        "        # Sort chronologically based on 'time' column\n",
        "        df = df.sort_values(by='time').reset_index(drop=True)\n",
        "        \n",
        "        # Extract continuous features\n",
        "        time = df['time'].values\n",
        "        magnitude = df['magnitude'].values\n",
        "        \n",
        "        # Calculate inter-event times (dt)\n",
        "        dt = np.diff(time)\n",
        "        # Shift magnitude so dt[i] and mag[i] correspond to the same sequential step\n",
        "        mag = magnitude[1:] \n",
        "        \n",
        "        # Normalize continuous variables for neural network stability\n",
        "        self.dt_mean, self.dt_std = dt.mean(), dt.std()\n",
        "        self.mag_mean, self.mag_std = mag.mean(), mag.std()\n",
        "        \n",
        "        dt_norm = (dt - self.dt_mean) / (self.dt_std + 1e-8)\n",
        "        mag_norm = (mag - self.mag_mean) / (self.mag_std + 1e-8)\n",
        "        \n",
        "        self.data = np.stack([dt_norm, mag_norm], axis=-1) # Shape: (N, 2)\n",
        "        self.seq_length = seq_length\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.data) - self.seq_length\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        # Input sequence: [t_0 ... t_N-1]\n",
        "        x = self.data[idx : idx + self.seq_length]\n",
        "        # Target sequence to predict: [t_1 ... t_N]\n",
        "        y = self.data[idx + 1 : idx + self.seq_length + 1]\n",
        "        return torch.tensor(x, dtype=torch.float32), torch.tensor(y, dtype=torch.float32)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Stage 2: Continuous Positional Encoding\n",
        "Standard sequence position encodings (like those in NLP) represent token order. Since our data occurs at irregular intervals, we explicitly map the continuous `dt` through sinusoidal functions."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Stage 2: Continuous Positional Encoding.\n",
        "# Maps continuous dt through sinusoidal functions so the transformer \n",
        "# natively understands irregular intervals between events.\n",
        "\n",
        "class ContinuousTimeEncoding(nn.Module):\n",
        "    def __init__(self, d_model):\n",
        "        super().__init__()\n",
        "        self.d_model = d_model\n",
        "        # Learnable frequencies for time encoding\n",
        "        self.w = nn.Parameter(torch.Tensor(1, d_model))\n",
        "        nn.init.xavier_uniform_(self.w)\n",
        "\n",
        "    def forward(self, dt):\n",
        "        # dt shape: (batch_size, seq_length, 1)\n",
        "        # Output shape: (batch_size, seq_length, d_model)\n",
        "        time_enc = dt * self.w\n",
        "        return torch.sin(time_enc)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Stage 3 & 4: Transformer Architecture & MDN Head\n",
        "The self-attention mechanism replaces the standard ETAS kernel. The output head uses a Mixture Density Network to output continuous probability distributions, bypassing the 'non-trained tokens' problem entirely."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "class MTPPTransformer(nn.Module):\n",
        "    def __init__(self, d_model=64, nhead=4, num_layers=2, num_mixtures=5):\n",
        "        super().__init__()\n",
        "        self.d_model = d_model\n",
        "        self.num_mixtures = num_mixtures\n",
        "        \n",
        "        # Project raw (dt, m) 2D vector into latent space\n",
        "        self.input_proj = nn.Linear(2, d_model)\n",
        "        \n",
        "        # Time encoding module\n",
        "        self.time_encoding = ContinuousTimeEncoding(d_model)\n",
        "        \n",
        "        # Stage 3: Self-attention as the triggering kernel\n",
        "        # Causal masking ensures predictions only depend on strictly past events.\n",
        "        encoder_layer = nn.TransformerEncoderLayer(d_model=d_model, nhead=nhead, batch_first=True)\n",
        "        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=num_layers)\n",
        "        \n",
        "        # Stage 4: Mixture Density Network (MDN) Head\n",
        "        # Resolves \"non-trained tokens\" by outputting a continuous probability distribution.\n",
        "        # It models the joint distribution for (dt, m). \n",
        "        # Outputs: mixture weights (pi), means (mu), and variances (sigma).\n",
        "        \n",
        "        # 5 mixtures * 2 variables (dt, m)\n",
        "        self.mdn_pi = nn.Linear(d_model, num_mixtures * 2) \n",
        "        self.mdn_mu = nn.Linear(d_model, num_mixtures * 2)\n",
        "        self.mdn_sigma = nn.Linear(d_model, num_mixtures * 2)\n",
        "\n",
        "    def generate_square_subsequent_mask(self, sz):\n",
        "        mask = (torch.triu(torch.ones(sz, sz)) == 1).transpose(0, 1)\n",
        "        mask = mask.float().masked_fill(mask == 0, float('-inf')).masked_fill(mask == 1, float(0.0))\n",
        "        return mask\n",
        "\n",
        "    def forward(self, x):\n",
        "        # x shape: (batch_size, seq_length, 2) where 2 is (dt, m)\n",
        "        batch_size, seq_length, _ = x.shape\n",
        "        \n",
        "        # Split features for temporal encoding\n",
        "        dt = x[:, :, 0].unsqueeze(-1)\n",
        "        \n",
        "        # Project inputs and add time encoding\n",
        "        h = self.input_proj(x) + self.time_encoding(dt)\n",
        "        \n",
        "        # Causal mask for autoregressive sequence modeling\n",
        "        mask = self.generate_square_subsequent_mask(seq_length).to(x.device)\n",
        "        \n",
        "        # Pass through transformer layers\n",
        "        out = self.transformer(h, mask=mask)\n",
        "        \n",
        "        # MDN Output layer\n",
        "        # Softmax over the mixture dimension to ensure probabilities sum to 1\n",
        "        pi = F.softmax(self.mdn_pi(out).view(batch_size, seq_length, 2, self.num_mixtures), dim=-1)\n",
        "        mu = self.mdn_mu(out).view(batch_size, seq_length, 2, self.num_mixtures)\n",
        "        # Exponentiate sigma to ensure variance is strictly positive\n",
        "        sigma = torch.exp(self.mdn_sigma(out)).view(batch_size, seq_length, 2, self.num_mixtures)\n",
        "        \n",
        "        return pi, mu, sigma"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Training Configuration & Loss\n",
        "Because the model outputs distributions rather than token logits, we optimize it using Negative Log-Likelihood (NLL) of the true continuous values given the predicted mixture distribution."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def mdn_loss_function(pi, mu, sigma, target):\n",
        "    # target shape: (batch_size, seq_length, 2) -> corresponding to true (dt, m)\n",
        "    # pi, mu, sigma shape: (batch_size, seq_length, 2, num_mixtures)\n",
        "    \n",
        "    target = target.unsqueeze(-1) # Expand target to broadcast across mixtures dimension\n",
        "    \n",
        "    # Gaussian PDF evaluation for continuous variables\n",
        "    dist = torch.distributions.Normal(loc=mu, scale=sigma)\n",
        "    log_probs = dist.log_prob(target)\n",
        "    \n",
        "    # Weight by mixture probabilities\n",
        "    log_pi = torch.log(pi + 1e-8)\n",
        "    \n",
        "    # Log-sum-exp trick for numerical stability when marginalizing the mixture components\n",
        "    weighted_log_probs = log_probs + log_pi\n",
        "    log_sum_exp = torch.logsumexp(weighted_log_probs, dim=-1)\n",
        "    \n",
        "    # Negative Log Likelihood over the sequence and batch\n",
        "    nll_loss = -torch.mean(log_sum_exp)\n",
        "    return nll_loss"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# --- Execution & Training Loop ---\n",
        "\n",
        "# Hyperparameters\n",
        "seq_length = 50\n",
        "batch_size = 32\n",
        "epochs = 10\n",
        "d_model = 64\n",
        "\n",
        "# Initialize Dataset and DataLoader using the provided example file\n",
        "try:\n",
        "    dataset = EarthquakeDataset('example_catalog.csv', seq_length=seq_length)\n",
        "    dataloader = DataLoader(dataset, batch_size=batch_size, shuffle=True)\n",
        "    print(f\"Dataset loaded successfully. Total sequences available: {len(dataset)}\")\n",
        "except FileNotFoundError:\n",
        "    print(\"File 'example_catalog.csv' not found in current directory. Ensure the file is present to run training.\")\n",
        "    dataloader = []\n",
        "\n",
        "# Initialize Model and Optimizer\n",
        "model = MTPPTransformer(d_model=d_model, nhead=4, num_layers=2, num_mixtures=5)\n",
        "optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
        "\n",
        "# Basic Training Loop\n",
        "if dataloader:\n",
        "    print(\"Starting training...\")\n",
        "    for epoch in range(epochs):\n",
        "        model.train()\n",
        "        total_loss = 0\n",
        "        for batch_x, batch_y in dataloader:\n",
        "            optimizer.zero_grad()\n",
        "            \n",
        "            # Forward pass through MTPP Transformer\n",
        "            pi, mu, sigma = model(batch_x)\n",
        "            \n",
        "            # Calculate continuous likelihood loss\n",
        "            loss = mdn_loss_function(pi, mu, sigma, batch_y)\n",
        "            \n",
        "            # Backward pass\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "            \n",
        "            total_loss += loss.item()\n",
        "            \n",
        "        avg_loss = total_loss / len(dataloader)\n",
        "        print(f\"Epoch {epoch+1}/{epochs} | Average NLL Loss: {avg_loss:.4f}\")\n"
      ]
    }
  ],
